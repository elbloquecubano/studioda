# Variables de entorno para el hosting (cPanel / Plesk con Node.js).
#
# NO subas este archivo con valores reales. En cPanel se ponen una a una en
# «Setup Node.js App» → Environment variables, que es donde Passenger las lee.
# Este archivo está sólo para tenerlas apuntadas.

# --- Obligatorias -----------------------------------------------------------

# Carpeta privada donde vive la base de datos. Tiene que estar FUERA de
# public_html: si queda dentro, cualquiera puede descargarse el .db con las
# contraseñas y los datos de tus clientes escribiendo la URL.
# Sustituye "usuario" por tu usuario de cPanel.
STUDIOSDA_DATA_DIR=/home/usuario/studiosda-datos

# Ruta de la base de datos. Si la dejas sin poner, se usa dev.db dentro de
# STUDIOSDA_DATA_DIR, que es lo normal.
# DATABASE_URL=file:/home/usuario/studiosda-datos/dev.db

# Secreto con el que se firman las sesiones. Si no lo pones, se genera solo y
# se guarda en STUDIOSDA_DATA_DIR/auth-secret. Ponlo a mano sólo si necesitas
# el mismo valor en varios sitios. Cambiarlo cierra todas las sesiones abiertas.
# Para generar uno: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=

# Marca las cookies de sesión como Secure. En HTTPS tiene que estar en true.
# Si tu dominio todavía va por HTTP, déjalo en false o nadie podrá entrar:
# el navegador descarta la cookie y el login parece que "no hace nada".
AUTH_COOKIE_SECURE=true

NODE_ENV=production

# --- Opcionales -------------------------------------------------------------

# Fuerza el compilador WASM al construir. Sólo si `npm run build` falla en el
# servidor con un error del binario nativo de SWC (glibc antigua, Alpine...).
# NEXT_USE_WASM=1
